# ==============================================================================
# ASCENT PLATFORM CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your real keys.
# ==============================================================================

# 1. DATABASE CONNECTION
# Used by Prisma ORM for PostgreSQL database migrations and runtime models.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ascent?schema=public"

# 2. GOOGLE GEMINI AI (https://aistudio.google.com/)
# Powers all AI capabilities: CV Parsing, ATS Scoring, JD Deflator analysis,
# resume tailoring, mock interview questions/evaluations, and role extraction.
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. SERPAPI GOOGLE JOBS ENGINE (https://serpapi.com/)
# Powers the "Smart Job Radar" feature by querying live Google Jobs listings.
SERPAPI_API_KEY="your_serpapi_api_key_here"

# 4. RESEND EMAIL SERVICE (https://resend.com/)
# Powers the in-app "Feedback" modal by dispatching user submissions to your inbox.
RESEND_API_KEY="re_your_resend_api_key_here"

# 5. RECIPIENT EMAIL FOR FEEDBACK
# The private administrator email address where user feedback submissions are delivered.
FEEDBACK_RECIPIENT_EMAIL="ngyibin@gmail.com"
