# ==============================================================================
# ASCENT PLATFORM CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your real keys:
#   cp .env.example .env
# ==============================================================================

# 1. DATABASE CONNECTION
# Used by Prisma ORM for PostgreSQL database migrations and backend schema management.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ascent?schema=public"

# 2. GOOGLE GEMINI AI (https://aistudio.google.com/)
# Powers all AI capabilities across Ascent:
# - CV Parsing & ATS scorecard scoring
# - Must-Have vs. Good-to-Have JD Deflator analysis
# - Tailored resume generation and skill gap coaching
# - Mock interview question generation & STAR answer evaluations
# - Domain-agnostic career role extraction for the Smart Job Radar
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. SERPAPI GOOGLE JOBS ENGINE (https://serpapi.com/)
# Powers the "Smart Job Radar" feature by querying live Google Jobs listings
# in real time based on your target role title and preferred search location.
SERPAPI_API_KEY="your_serpapi_api_key_here"

# 4. RESEND EMAIL SERVICE (https://resend.com/)
# Powers the in-app "Feedback" modal by dispatching user bug reports, feature
# ideas, and general comments directly to your inbox via Resend's email API.
RESEND_API_KEY="re_your_resend_api_key_here"

# 5. RECIPIENT EMAIL FOR FEEDBACK
# The private administrator email address where user feedback submissions are
# delivered. Handled strictly on the server (/api/feedback) and never exposed to the client.
FEEDBACK_RECIPIENT_EMAIL="your_email@example.com"
